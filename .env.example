# GMGN API Authentication
# Get these from your browser's developer tools when logged into gmgn.ai
GMGN_BEARER_TOKEN=your_bearer_token_here
GMGN_COOKIES=your_cookies_here

# Optional: Override default values
GMGN_DEVICE_ID=7754041a-7df7-4454-80aa-2160aec01882
GMGN_CHAIN=bsc

# Telegram Bot Configuration
# Create a bot with @BotFather and get the token
TELEGRAM_BOT_TOKEN=123456:efGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-10012

# Optional: Separate chat for wallet notifications
# TELEGRAM_WALLET_CHAT_ID=-1001234567891

# Captcha Solving Service (optional)
# Get API key from solvercaptcha.com or similar service
# If not provided, will fall back to manual captcha solving
CAPTCHA_API_KEY=434e0591200d4bf13c14ca3c8b771da5